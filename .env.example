# ---------------------------------------------------------------------------
# CareCapital Exchange — environment configuration
#
# The application runs with ZERO configuration in demo mode. Every variable
# below is optional; when unset, a local development implementation is used.
# Copy to `.env.local` and fill in only what you need.
# ---------------------------------------------------------------------------

# Data / auth driver: "local" (file-backed demo store) or "supabase".
DATA_DRIVER=local

# Signing secret for session cookies and short-lived document tokens.
# REQUIRED in production. Generate with: openssl rand -hex 32
AUTH_SECRET=

# --- Supabase (only required when DATA_DRIVER=supabase) --------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=deal-documents

# --- Email delivery ---------------------------------------------------------
# Both are required for real delivery (Resend's HTTP API; no SDK needed).
# Unset => delivery is logged to the server console, and screens that depend on
# email — the sign-in link on /login — hide themselves in production rather
# than promising a message that will never arrive.
RESEND_API_KEY=
EMAIL_FROM=

# --- AI provider ------------------------------------------------------------
# Unset => deterministic local analyst (no network calls, fully functional).
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Per-task model routing (see lib/ai/routing.ts for defaults).
AI_MODEL_EXTRACTION=
AI_MODEL_REASONING=
AI_MODEL_MEMO=
AI_MODEL_CHAT=
AI_MODEL_CLASSIFICATION=
AI_MONTHLY_BUDGET_USD=250

# --- Billing (Stripe) — optional, not required for the MVP ------------------
BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Email / notifications --------------------------------------------------
# Unset => notifications are written to the in-app inbox and the server log.
EMAIL_PROVIDER=mock
EMAIL_FROM=notifications@carecapital.exchange

# --- Observability ----------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=

# --- Demo data --------------------------------------------------------------
# Seeds fictional lenders, deals, documents and indications on first boot.
SEED_DEMO_DATA=true
